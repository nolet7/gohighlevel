# Copy to .env. Every variable is prefixed HGE_.
HGE_ENV=dev                      # dev | staging | prod  (prod refuses placeholder secrets)
HGE_MODE=mock                    # mock | live
HGE_COMPANY_NAME=Summit HVAC
HGE_TIMEZONE=America/New_York
HGE_DATABASE_PATH=data/engine.db
HGE_LOG_LEVEL=INFO

# --- security (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
HGE_WEBHOOK_SECRET=change-me             # HMAC key shared with Make/Zapier/n8n/GHL for signed webhooks
HGE_WEBHOOK_STATIC_TOKEN=                # optional: for GHL's native webhook action (static header only)
HGE_ADMIN_API_KEY=change-me-too          # Bearer token for /admin/*
HGE_FIELDPULSE_WEBHOOK_TOKEN=change-me   # secret path segment for /webhooks/fieldpulse/<token>

# --- compliance
HGE_QUIET_HOURS_START=21
HGE_QUIET_HOURS_END=8
HGE_MARKETING_CAP_PER_WEEK=4
HGE_MISSED_CALL_IMPLIED_CONSENT=true     # confirm with counsel before go-live
HGE_REVIEW_LINK=

# --- calendar-fill campaign
HGE_FILL_WINDOW_START_DAYS=7
HGE_FILL_WINDOW_END_DAYS=14
HGE_FILL_MAX_SLOW_DAY_FRACTION=0.75      # anomaly guard: abort if nearly every workday looks empty
HGE_FILL_OPEN_THRESHOLD=0.5
HGE_FILL_MAX_TARGETS=40
HGE_FILL_EXPECTED_BOOKING_RATE=0.08      # ASSUMPTION: calibrate with real data
HGE_FILL_TARGET_FILL_FRACTION=0.5
HGE_FILL_OFFER=$40 off
HGE_FILL_MIN_MONTHS_SINCE_SERVICE=6
HGE_CAMPAIGNS_LIVE=false                 # false = scheduled campaigns only PLAN (dry-run)

# --- live mode only
HGE_GHL_BASE_URL=https://services.leadconnectorhq.com
HGE_GHL_TOKEN=
HGE_GHL_LOCATION_ID=
HGE_GHL_API_VERSION=2021-07-28           # verify with scripts/ghl_probe.py
HGE_GHL_PIPELINE_ID=
HGE_GHL_STAGE_IDS={}                     # JSON: {"New Lead":"<stageId>","Booked":"<stageId>"}
HGE_FIELDPULSE_BASE_URL=https://ywe3crmpll.execute-api.us-east-2.amazonaws.com/stage
HGE_FIELDPULSE_API_KEY=                  # request from support@fieldpulse.com
HGE_FP_TECH_COUNT=3                      # FieldPulse has no availability API: capacity is configured
HGE_FP_SLOTS_PER_TECH_PER_DAY=4
HGE_FP_WORKDAYS=0,1,2,3,4,5              # Mon=0 ... Sun=6
HGE_FP_SNAPSHOT_TTL_SECONDS=60

# --- scheduler (single instance only)
HGE_SCHEDULER_ENABLED=false
HGE_TICK_SECONDS=60
